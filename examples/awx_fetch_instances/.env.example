# AWX Configuration Example
# Copy this file to .env and update with your values
# Usage: source .env && ./awx_inventory_fetch.sh

# AWX Server URL (required)
AWX_HOST=https://awx.example.com

# Authentication (choose one method)
# Method 1: Token (recommended)
AWX_TOKEN=your_api_token_here

# Method 2: Username/Password
# AWX_USERNAME=admin
# AWX_PASSWORD=your_password_here

# SSL Verification (set to false for self-signed certs)
AWX_VERIFY_SSL=true

# Default Inventory ID (optional, can override with -i flag)
INVENTORY_ID=
